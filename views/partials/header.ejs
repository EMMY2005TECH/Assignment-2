<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  /*changes browser title depending on page in view*/
  <title><%= title %> - Emmanuel Okpara</title> 

  /*This makes websites responsive on phone, tablet and desktop so I dont have to create separate files
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  
  /*This contains icons that can be placed anywhere in nav bar/ footer */
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

  
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>

/*used to make footer automatically stick to bottom of screen even without much content to push it down */
<body class="d-flex flex-column min-vh-100"> 

  
  <header>
    <nav class="navbar navbar-expand-lg navbar-dark custom-header shadow-sm"> /* builds responsive nav bar which expands on big screens and collapses on small screens and sets text to light color scheme */
      <div class="container">

        <a class="navbar-brand fw-bold" href="/">
          <i class="fa-solid fa-shield-halved me-2"></i>Emmanuel Okpara
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"> /* Tells browser which menu items to show/hide when button is clicked */
          <span class="navbar-toggler-icon"></span> /* creats a clickable button which appears on phones and tabs when screen is small to show links to side */
        </button>

        <div class="collapse navbar-collapse" id="navbarNav"> /* makes it so nav links collapse into hidden drop menu on phones.
          <ul class="navbar-nav ms-auto">

            <li class="nav-item">
              <a class="nav-link <%= title === 'Home' ? 'active' : '' %>" href="/">checks if page title sent from index.js matches home. if it matches, it sends bootstrap active , if it doesnt , nothing outputs */
                <i class="fa-solid fa-house me-1"></i> Home
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= title === 'About Me' ? 'active' : '' %>" href="/about">
                <i class="fa-solid fa-user me-1"></i> About Me
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= title === 'Projects' ? 'active' : '' %>" href="/projects">
                <i class="fa-solid fa-diagram-project me-1"></i> Projects
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= title === 'Contact Me' ? 'active' : '' %>" href="/contact">
                <i class="fa-solid fa-envelope me-1"></i> Contact Me
              </a>
            </li>
          </ul>
        </div>
      </div>
    </nav>
  </header>

  
   /* stretch and expand to vertically fill any empty space on screen and keeps footer pinned to bottom. */
  <main class="container my-5 flex-grow-1">