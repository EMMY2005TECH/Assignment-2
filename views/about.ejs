<%- include('partials/header') %>

<div class="bg-white p-4 rounded-3 shadow-sm">
  <h1 class="mb-4"><i class="fa-solid fa-id-card text-danger me-2"></i>About Me</h1>
  
  <!-- Bootstrap Responsive Grid Row -->
  <div class="row align-items-start">
    <!-- Left Column: Profile Picture -->
    <div class="col-md-4 text-center mb-4">
      <figure class="figure">
        <img src="/images/aboutme.jpg" class="figure-img img-fluid rounded shadow-sm" alt="Emmanuel Okpara Profile Picture">
        <figcaption class="figure-caption fw-bold mt-2">Emmanuel Okpara</figcaption>
      </figure>
    </div>

    <!-- Right Column: Bio and Introductory Video -->
    <div class="col-md-8">
      <p class="fs-5">
        I am a student at Ontario Tech University pursuing a degree in <strong>Networking and IT Security</strong>. Alongside my studies, I work as an independent IT support technician specializing in hardware diagnostics, OS installations, and local network configurations.
      </p>
      <p>
        I hold a Google Technical Support Fundamentals certification and enjoy building local-first smart home systems, scripting games, and long-term index investing.
      </p>

      <h3 class="mt-4 mb-3"><i class="fa-solid fa-video text-primary me-2"></i>Introductory Video</h3>
      <video class="w-100 rounded shadow-sm" controls poster="/images/poster.jpg">
        <source src="/videos/aboutme.mp4" type="video/mp4">
        <source src="/videos/aboutme.ogv" type="video/ogg">
        Your browser does not support the HTML5 video tag.
      </video>
    </div>
  </div>
</div>

<%- include('partials/footer') %>